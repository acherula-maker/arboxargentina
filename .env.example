# ─── 17track ──────────────────────────────────────────────
# Obtené tu API key en: https://api.17track.net
TRACK17_API_KEY=tu_api_key_aqui

# Secret para verificar firma de webhooks (lo configurás en el portal de 17track)
TRACK17_WEBHOOK_SECRET=tu_webhook_secret_aqui

# URL pública donde escucha el servidor (necesaria para registrar el webhook en 17track)
# En desarrollo podés usar ngrok: https://ngrok.com
PUBLIC_URL=https://tudominio.com

# ─── Email (SMTP) ─────────────────────────────────────────
# Configuración para envío de notificaciones a clientes
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_app_password_gmail
EMAIL_FROM=GlobalCargo <notificaciones@globalcargo.com>

# ─── USPS Web Tools API (gratuita) ───────────────────────
# Registrate en: https://registration.shippingapis.com/
# Necesario para trackear números USPS (9400..., 9300..., etc.)
USPS_USER_ID=tu_user_id_de_usps

# ─── Meta / Facebook Pixel + Conversions API (CAPI) ──────
# El pixel del navegador ya está en index.html (ID fijo). Estas variables activan
# el envío server-side (CAPI) en /api/track. Si META_CAPI_TOKEN queda vacío, el
# endpoint no hace nada (el pixel del navegador sigue funcionando igual).
META_PIXEL_ID=943206914715277
# Token de System User con permiso sobre el dataset, generado en
# Eventos > Configuración > Conversions API > Generar token de acceso.
META_CAPI_TOKEN=

# ─── Servidor ─────────────────────────────────────────────
PORT=3000
SESSION_SECRET=cambia_esto_por_un_string_largo_y_random
POLL_INTERVAL_MIN=30
DAILY_REPORT_HOUR=21
